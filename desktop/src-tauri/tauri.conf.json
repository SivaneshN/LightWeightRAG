{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightWeightRAG",
  "version": "0.1.0",
  "identifier": "org.lightweightrag.desktop",
  "build": {
    "frontendDist": "../../desktop-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Private local research assistant",
    "longDescription": "Ask questions about your own research documents using local language models.",
    "resources": [
      "resources/backend/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
